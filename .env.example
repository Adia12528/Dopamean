# Copy to .env for local development. Generate unique secrets for every environment.
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
USER_JWT_SECRET=replace-with-a-different-long-random-secret
ADMIN_PASSCODE=replace-with-a-unique-admin-passcode

# Supabase Postgres connection string (use the Session Pooler for hosted Node apps).
# Copy from Supabase Dashboard → Connect → Session pooler. Keep the password private.
SUPABASE_DB_URL=

# Supabase Auth project URL and publishable key. Publishable keys are safe in the browser;
# never place a secret/service-role key in a VITE_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development uses the Vite proxy. Production builds require the HTTPS API origin.
VITE_API_BASE_URL=
CORS_ORIGIN=

# Optional separate super-admin account
SUPER_ADMIN_ID=
SUPER_ADMIN_PASSWORD=
DELIVERY_AGENT_PASSCODE=

# Required only when enabling Razorpay. The webhook value is the signing secret,
# not the webhook URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
