# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=5000

# PostgreSQL is optional for local development (SQLite is used when unset).
# For production, use the Supabase Session Pooler connection string.
SUPABASE_DB_URL=
DB_POOL_SIZE=10

# Supabase project configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# Browser-visible values. VITE_ variables are embedded in the frontend build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Production API configuration. CORS_ORIGIN is a comma-separated list of HTTPS
# storefront origins without paths. Local development may leave it blank.
JWT_SECRET=
USER_JWT_SECRET=
ADMIN_PASSCODE=
CORS_ORIGIN=

# Optional server-side credentials.
SUPER_ADMIN_ID=
SUPER_ADMIN_PASSWORD=
DELIVERY_AGENT_PASSCODE=

# Optional Razorpay configuration. Webhook secret means the signing secret,
# not the webhook URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional PayU India configuration. Credentials may also be set in Studio.
# Keep this encryption key stable so saved PayU credentials remain decryptable.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_CREDENTIALS_ENCRYPTION_KEY=
PAYU_CALLBACK_BASE_URL=

# Optional new-order email notifications. Fill SMTP credentials in Render
# environment settings; never commit real passwords or app passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_NOTIFICATION_EMAIL=
